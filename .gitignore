# --- secrets / local state (NEVER commit) ---
.env
.env.*
!.env.example
# local SQLite dir at the repo root only — NOT app/data/ (ships the VLESS inbound template)
/data/
*.db
*.sqlite*
*.log

# local-only working files (secrets / planning / scratch notes) — never publish
*.local.md
*.local.txt
TODO.md
CLAUDE.md

# fleet migration workspace: SSH keys + migration notes for the new servers.
# Extension-less private keys (e.g. vespn_fleet) and .pub files are NOT caught by
# the id_rsa*/*.pem/*.key patterns below, so ignore the whole folder.
migration/

# Real exported VPN configs contain live private keys / PSK / server host.
# Keep them out of the repo (the format is documented in app/awg.py).
examples/
*.vpn
*.conf
id_rsa*
*.pem
*.key

# --- python ---
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/

# --- editors / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db
