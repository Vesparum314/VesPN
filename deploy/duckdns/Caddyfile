{
	# We can't use port 80 (fictorium owns it), so no HTTP->HTTPS redirectors.
	auto_https disable_redirects
}

# Panel served over HTTPS on :8443 with a real Let's Encrypt cert obtained via
# the DuckDNS DNS-01 challenge.
{$PANEL_DOMAIN}:8443 {
	reverse_proxy panel:8000
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
		resolvers 1.1.1.1
	}
	encode gzip
}
