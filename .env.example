# Copy to .env and edit. KEEP .env SECRET — it is git-ignored for a reason.
# Everything here has a safe default except PANEL_SECRET_KEY and ADMIN_PASSWORD.

# ========================= REQUIRED =========================

# Signs session cookies AND encrypts every stored node secret (SSH passwords,
# 3x-ui API tokens, pool keys) at rest. Must be long, random and STABLE —
# changing it invalidates all sessions and makes stored secrets unreadable
# (you'd have to re-enter them). Generate once:  openssl rand -base64 48
PANEL_SECRET_KEY=

# First-run admin account (created only when the DB has no users yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ========================= PANEL =========================

# SQLite file path. In Docker it lives in the `paneldata` volume (see compose).
DATABASE_URL=sqlite:///./data/panel.db

# Where `docker compose up` publishes the panel. Default is localhost-only;
# reach it via an SSH tunnel or a reverse proxy. Set 0.0.0.0:8443 to expose.
PANEL_BIND=127.0.0.1:8080

# Temporary password given to admin-created users; they must change it on first
# login.
DEFAULT_USER_PASSWORD=change-me-123

# Set true once the panel is served over HTTPS (the session cookie becomes Secure).
SESSION_HTTPS_ONLY=false

# Optional UI theme: a directory (inside the container) with static/theme.css and/or
# templates/ overrides — see README → «Темы оформления». Unset = stock look.
THEME_DIR=
# Product name in the header, on the login page and in page titles.
BRAND_NAME=VesPN

# ========================= PROVISIONING =========================

# Pin freshly provisioned nodes to a known-good Xray-core (the installer's latest
# fails on some clients). Change only if you've tested a newer one.
XRAY_VERSION=v26.6.27

# AmneziaWG server container the panel deploys on each exit (official image).
AWG_IMAGE=amneziavpn/amneziawg-go:latest
AWG_CONTAINER=vespn-awg
AWG_CONF_DIR=/opt/vespn-awg

# ========================= HTTPS (DuckDNS overlay) =========================
# Only used by deploy/docker-compose.duckdns.yml (free HTTPS without port 80).
PANEL_DOMAIN=your-name.duckdns.org
DUCKDNS_TOKEN=

# ========================= TELEGRAM BOT (optional) =========================
# Daily backup+stats, hourly monitoring + alerts, and /check /status /backup.
# These are a BOOTSTRAP fallback — the bot's settings are normally managed in the
# admin UI (Мониторинг → Настройки бота) and stored encrypted in the DB.
# Leave blank to keep the bot dormant.
TG_BOT_TOKEN=
# Comma-separated chat ids that receive messages and may issue commands.
TG_ADMIN_CHAT=
# Telegram's API is blocked from inside RU, where the gate/Hub usually lives.
# Point the bot at a reachable reverse proxy that forwards to api.telegram.org
# (the panel can stand one up on an exit — see README). Default = direct.
TG_API_BASE=https://api.telegram.org
TG_BACKUP_HOUR=6        # UTC hour for the daily backup
TG_MONITOR_MINUTES=60   # monitoring cadence (minutes)
